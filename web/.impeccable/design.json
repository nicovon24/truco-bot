      "css": ".ds-primary{font-family:var(--font-sans,Archivo,ui-sans-serif,system-ui,sans-serif);display:flex;align-items:center;justify-content:center;gap:12px;min-height:56px;width:100%;padding:14px 22px;border:0;border-radius:8px;background:var(--color-sky,#8ed8ed);color:var(--color-night,#0b1d2a);font-size:18px;font-weight:850;font-stretch:condensed;text-transform:uppercase;letter-spacing:.025em;box-shadow:0 6px 18px rgb(0 0 0 / .2);cursor:pointer;transition:background .18s,transform .18s}.ds-primary:hover:enabled{background:#b5ebf7;transform:translateY(-2px)}.ds-primary:active:enabled{transform:translateY(1px)}.ds-primary:disabled{opacity:.5;cursor:not-allowed}.ds-primary:focus-visible{outline:3px solid var(--color-sky,#8ed8ed);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-canto,.ds-utility,.ds-naipe{transition:none;animation:none}}"
