      "html": "<nav class=\"ds-header\" aria-label=\"Inicio\"><a href=\"/\" class=\"ds-wordmark\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"m7 5 11 2-3 15L4 20Z\"/><path d=\"m9 2 12 3-3 16\"/></svg>TRUCO BOT</a></nav>",
      "css": ".ds-header{padding:18px 36px;background:var(--color-night,#0b1d2a)}.ds-wordmark{font-family:var(--font-sans,Archivo,ui-sans-serif,system-ui,sans-serif);display:inline-flex;align-items:center;gap:10px;color:var(--color-cream,#f4eedc);font-size:16px;font-weight:850;letter-spacing:-.02em;text-decoration:none}.ds-wordmark svg{width:25px;height:25px;color:var(--color-sky,#8ed8ed)}.ds-wordmark:focus-visible{outline:3px solid var(--color-sky,#8ed8ed);outline-offset:5px}"
